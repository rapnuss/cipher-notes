{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "build": "NODE_ENV=production bun build src/index.ts --outdir dist --target bun --minify --sourcemap",
    "start": "NODE_ENV=production bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-presigned-post": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-zod-api": "^29.8.2",
    "hcaptcha": "^0.2.0",
    "http-errors": "^2.0.1",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/pg": "^8.23.1",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.9"
  }
}
